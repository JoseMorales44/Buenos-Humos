# Local API + optional Netlify Functions (never commit real keys)
GROQ_API_KEY=

# Dev-only fallback read by server/cultivationChatCore (not used in React)
# VITE_API_GROQ_KEY=

# Optional: custom Groq fetch timeout (ms). Default 45000 local; Netlify function uses ~9500.
# CULTIVATION_CHAT_TIMEOUT_MS=

# Only if API is on another origin (usually empty on Netlify with netlify.toml rewrite)
# VITE_API_BASE_URL=

# Google Analytics 4 (injected in index.html via Vite HTML env replacement)
VITE_GA4_MEASUREMENT_ID=
# Google Search Console verification code
VITE_GSC_VERIFICATION_CODE=

# WordPress credentials for scripts
WP_BASE_URL=https://gold-meerkat-677072.hostingersite.com
WP_USER=
WP_PASSWORD=
