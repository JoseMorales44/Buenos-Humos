{
  "name": "buenos-humos-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:vite": "vite",
    "start:api": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "verify:wp": "tsx --env-file=.env.local scripts/verifyWp.ts",
    "seed:wp": "tsx --env-file=.env.local scripts/seedWpCatalog.ts",
    "upload:xlsx": "tsx --env-file=.env.local scripts/uploadProductsXlsx.ts",
    "clean:packs": "tsx --env-file=.env.local scripts/deletePackProducts.ts",
    "upload:images": "tsx --env-file=.env.local scripts/uploadProductImages.ts",
    "fetch:images": "tsx --env-file=.env.local scripts/fetchProductImages.ts",
    "fill:descriptions": "tsx --env-file=.env.local scripts/fillProductDescriptions.ts"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@iconify/react": "^6.0.2",
    "@tanstack/react-query": "^5.99.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "framer-motion": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@netlify/functions": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.7.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "vercel": "^51.7.0",
    "vite": "^6.0.0",
    "vite-plus": "^0.1.12",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@9.15.4"
}
